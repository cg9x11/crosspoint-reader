{
  "plugin": {
    "id": "truyen-full",
    "name": "Truyện Full",
    "version": 10,
    "author": "vBook",
    "deviceSupport": [
      "x3",
      "x4"
    ],
    "description": "Đọc truyện trên trang Truyện Full"
  },
  "runtime": {
    "mode": "adapter",
    "adapter": {
      "origin": "vbook",
      "profile": "truyenfull",
      "sourceLanguage": "javascript",
      "scriptFiles": [
        "chap.js",
        "config.js",
        "detail.js",
        "gen.js",
        "genre.js",
        "home.js",
        "page.js",
        "search.js",
        "toc.js"
      ],
      "entrypoints": {
        "home": "home.js",
        "genre": "genre.js",
        "detail": "detail.js",
        "search": "search.js",
        "page": "page.js",
        "toc": "toc.js",
        "chap": "chap.js"
      }
    }
  },
  "source": {
    "baseUrl": "https://truyenfull.vision",
    "locale": "vi-VN",
    "contentType": "webnovel",
    "supportsSearch": true,
    "supportsTrackedUpdates": false,
    "regexp": "(www.)?truyenfull.(vn|net|io|bio|vision)/[^/]+/?$"
  }
}
