{
  "name": "xteinkreader-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "worker:dev": "tsx watch src/worker/index.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-generated-prisma.mjs",
    "start": "node dist/src/index.js",
    "worker:start": "node dist/src/worker/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "storage:ensure": "tsx scripts/ensure-storage.ts",
    "queue:smoke": "tsx scripts/enqueue-smoke.ts",
    "smoke:mobile": "node scripts/playwright-smoke.mjs",
    "validate": "npm run prisma:generate && npm run build"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@prisma/client": "^6.8.2",
    "acorn": "^8.15.0",
    "acorn-walk": "^8.3.4",
    "bullmq": "^5.53.1",
    "cheerio": "^1.1.2",
    "dotenv": "^16.4.5",
    "fastify": "^5.3.3",
    "fflate": "^0.8.2",
    "iconv-lite": "^0.7.0",
    "ioredis": "^5.4.1",
    "magic-string": "^0.30.21",
    "node-cron": "^4.2.1",
    "pino-pretty": "^13.1.3",
    "playwright-core": "^1.59.1",
    "sanitize-html": "^2.17.0",
    "sharp": "^0.34.4",
    "yazl": "^3.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.1",
    "@types/sanitize-html": "^2.16.0",
    "@types/yazl": "^3.3.0",
    "prisma": "^6.8.2",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
